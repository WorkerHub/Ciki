{
  "name": "ciki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:web && concurrently \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker dev",
    "build": "pnpm build:web && pnpm build:worker",
    "build:web": "pnpm --filter web build",
    "build:worker": "pnpm --filter worker build",
    "typecheck": "pnpm --filter web typecheck && pnpm --filter worker typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "pnpm --filter worker test && pnpm --filter web test",
    "check:deploy": "pnpm --filter worker exec wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "concurrently": "^10.0.3",
    "typescript": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.18.0"
}
